# Copy this file to `.env` before starting the app:
#   cp .env.example .env
# The start scripts do this automatically if `.env` is missing.

# Optional: Ollama configuration for local LLM.
# Ollama runs on the host, but the app runs in a container, so `localhost` here
# would resolve to the container itself. `host.docker.internal` is the host.
# Running the backend directly on your machine instead? Use http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=60

# Optional: Massive (Polygon.io) API key for real market data
# If not set, the built-in market simulator is used (recommended for most users)
MASSIVE_API_KEY=

# Optional: Set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false
